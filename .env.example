# Copy this file to .env and fill it in. Never commit .env.
# Bot token from Discord Developer Portal > application > Bot.
DISCORD_BOT_TOKEN=
# Your own numeric Discord user ID (enable Developer Mode to copy it).
DISCORD_PING_USER_ID=
# Optional DM recipient/owner override; normally leave blank.
DISCORD_DM_USER_ID=
# Blank = bot DMs. Otherwise use a private server channel ID.
DISCORD_CHANNEL_ID=
DISCORD_PING_ON=blocked,needs_input,failed
DISCORD_SEND_TURN_COMPLETE=false
# Include repository metadata in notifications; disabled for privacy by default.
DISCORD_INCLUDE_GIT=false
DISCORD_TIMEOUT_SECONDS=15
DISCORD_MAX_RETRIES=3
# 0 disables expiration; pending uploads and replies remain protected.
DISCORD_MEDIA_RETENTION_DAYS=7
